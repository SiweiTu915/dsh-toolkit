{
  "name": "dsh-remote-files",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把「可写的远程文件树」做进 dsh 工作台的右侧栏(增删改查 + 拖拽上传 + 下载 + 按类型分派编辑器)",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right"],
      "platform": "web"
    }
  }
}
